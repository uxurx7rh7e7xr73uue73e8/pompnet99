# ---------------------------------------------------------------------------
# POMP NET CLOUD — server configuration
# Copy to .env and fill in. Never expose these values to the browser.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for OAuth redirects and email links)
APP_URL=http://localhost:8080

# 32+ random bytes, base64. Encrypts provider tokens + secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
APP_SECRET=

# SQLite database file (defaults to ./data/pompnet.db)
DATABASE_PATH=./data/pompnet.db

# HTTP port
PORT=8080

# Bootstrap the platform owner account (first matching registration is promoted)
PLATFORM_OWNER_EMAIL=

# --- Optional integrations -------------------------------------------------
# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP for verification / password-reset email. When unset, links are shown
# in-app with an explicit "email delivery not configured" notice.
SMTP_URL=
MAIL_FROM=no-reply@pompnet.cloud

# Secret used to verify inbound provider webhooks (HMAC SHA-256)
WEBHOOK_SECRET=
